# =============================================================
# GOLD SMC AI PRO - environment configuration
# Copy this file to ".env" and fill in real values.
# NEVER commit .env. It is blocked from web access by .htaccess.
# =============================================================

APP_NAME="GOLD SMC AI PRO"
# production | local
APP_ENV=local
APP_DEBUG=false
# Public base URL (no trailing slash), e.g. http://localhost/Siganl_agent
APP_URL=http://localhost/Siganl_agent
# Default display timezone (users can override in Settings). Storage is always UTC.
APP_TIMEZONE=Asia/Bangkok
# Allow public self-registration (new users get the "trader" role)
ALLOW_REGISTRATION=true

# ---------- Database (MySQL 8 / MariaDB 10.4+) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gold_smc_ai
DB_USER=root
DB_PASS=

# ---------- Market data ----------
# twelvedata = live data from https://twelvedata.com (needs API key, supports XAU/USD)
# demo       = clearly-labelled SYNTHETIC data for UI/engine testing only
MARKET_PROVIDER=demo
TWELVEDATA_API_KEY=
TWELVEDATA_SYMBOL=XAU/USD
TWELVEDATA_BASE_URL=https://api.twelvedata.com
# HTTP behaviour for all outbound requests
HTTP_TIMEOUT=15
HTTP_RETRIES=2

# ---------- AI explanation provider (OpenAI-compatible Chat Completions) ----------
# none   = deterministic rule-based explanation only
# openai = any OpenAI-compatible endpoint (OpenAI, Azure-compatible proxies,
#          Google Gemini OpenAI-compat endpoint, local LLM servers, ...)
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT=30

# ---------- Economic calendar ----------
# faireconomy = public weekly ForexFactory export (nfs.faireconomy.media), this week only
# manual      = events entered by admins only
CALENDAR_PROVIDER=faireconomy
CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json

# ---------- Notifications ----------
TELEGRAM_BOT_TOKEN=
# Email uses PHP mail(); configure sendmail/SMTP in php.ini on your host.
MAIL_FROM=alerts@example.com

# ---------- Cron ----------
# Secret token required to trigger cron/run.php over HTTP (?token=...). CLI needs no token.
CRON_TOKEN=change-me-to-a-long-random-string
